{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixelwrigh",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm run build"
  },
  "main": "dist/_worker.js/index.js",
  "assets": {
    "directory": "dist"
  },
  "observability": {
    "enabled": true
  }
}
